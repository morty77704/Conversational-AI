APP_NAME=Conversational AI
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGIN=http://localhost:8080
COLLECTION_NAME=abc_kb_bge_v1
CHROMA_PATH=D:/workspace/Conversational AI/runtime/chroma
TESSERACT_CMD=D:/ocr/Tesseract/tesseract.exe
OCR_LANGUAGES=chi_sim+eng
EMBEDDING_MODEL=D:\\workspace\\model\\bge-base-zh-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
EMBEDDING_EXPECTED_DIMENSION=768
RERANKER_MODEL_PATH=replace_with_local_bge_reranker_large_path
RERANKER_DEVICE=cuda
RERANKER_USE_FP16=true
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512
RERANKER_TOP_N=3
INTENT_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=replace_with_openai_compatible_base_url
LLM_MODEL=replace_with_model_name
LLM_TEMPERATURE=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace_with_mysql_user
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_DATABASE=conversational_ai
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=5
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_authorization_code
SMTP_SENDER_EMAIL=replace_with_sender_email
SMTP_USE_SSL=false
